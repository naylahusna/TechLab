{
  "expo": {
    "name": "TechLab",
    "slug": "TechLab",
    "scheme": "techlab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo.png",
        "monochromeImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.TechLab"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Digunakan untuk menampilkan posisi kamu di Maps dan memverifikasi lokasi saat mencatat presensi."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Digunakan untuk memindai barcode QR presensi praktikum."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "02afd4cf-8633-4596-a44d-f773d48cb1cb"
      }
    }
  }
}
