# Server only. Copy to .env.ai.local; never use EXPO_PUBLIC_ for these credentials.
PERMISSION_AI_BASE_URL=https://aotianzz.xyz/v1
PERMISSION_AI_API_KEY=
PERMISSION_AI_MODEL=gpt-5.6
# For a phone on the same LAN, use 0.0.0.0 here and the laptop LAN IP in the app URL.
PERMISSION_AI_HOST=127.0.0.1
PERMISSION_AI_PORT=8787
# Additional allowed web origins, separated by commas. Loopback HTTP is allowed locally.
PERMISSION_AI_ALLOWED_ORIGINS=
