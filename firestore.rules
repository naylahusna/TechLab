rules_version = '2';
// Data model: users/{Firebase Auth UID}
// uid: string (1..128), immutable; name: string (2..100, trimmed)
// number: string (1..32 alphanumeric, dot or hyphen)
// role: 'praktikan' | 'asisten', immutable to clients
// createdAt: timestamp, immutable; updatedAt: timestamp, server time
// Email remains in Firebase Authentication; no collection-wide profile reads.
// SRS-06..17 collections are denied until their owners add reviewed rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function uidUnchanged(userId) { return request.resource.data.uid == userId; }
    function uidNotModified() { return request.resource.data.uid == resource.data.uid; }
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'number', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'number', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.name == data.name.trim()
        && data.number is string && data.number.size() > 0 && data.number.size() <= 32
        && data.number.matches('^[A-Za-z0-9.-]+$')
        && data.role in ['praktikan', 'asisten']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && uidUnchanged(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.role == 'praktikan'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId) && uidNotModified()
        && isValidUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'number', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
